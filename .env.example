# Telegram
BOT_TOKEN=
ADMIN_IDS=
LOG_CHANNEL_ID=

# MongoDB Atlas (use a database user and restrict allowed IPs)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=store_bot

# Generate once and keep this key unchanged across every deployment:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# Optional Telegram API credentials for Telethon OTP feature
API_ID=
API_HASH=

# Store settings (these can also be changed in the admin panel)
STORE_NAME=Premium Account Store
UPI_ID=
UPI_NAME=
SUPPORT_CONTACT=
MIN_DEPOSIT=50
REFERRAL_PERCENT=5
OTP_WINDOW_HOURS=24

# Server 2 - TG-Lion provider (keep secrets private)
TG_LION_API_KEY=
TG_LION_YOUR_ID=
TG_LION_BASE_URL=https://www.tg-lion.net/
SERVER2_MARKUP_PERCENT=10
SERVER2_USD_INR=90

# Runtime settings
CURRENCY=₹
TZ_OFFSET_MINUTES=330
PAYMENT_TIMEOUT_MIN=15
MAX_PENDING_DEPOSITS=3
RATE_LIMIT=15
